    "next-themes": "^0.4.6",
    "pg": "^8.21.0",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "react-is": "^19.2.9",
    "recharts": "^3.10.1",
    "sonner": "^1.5.0",
    "tailwind-merge": "^3.7.0",
