{
  "name": "saas-fluxen",
  "version": "2.0.0",
  "private": true,
  "description": "Fluxen - Modern SaaS ERP for Revenue & Expense Management",
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:fresh": "node scripts/free-port.mjs 3000 && next dev -p 3000",
    "free-port": "node scripts/free-port.mjs 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "node scripts/clean-next.mjs",
    "rebuild": "npm run clean && npm run build",
    "audit:rent": "node scripts/audit-supabase-remote.mjs",
    "audit:security": "node scripts/audit-database-security.mjs",
    "audit:integrity": "node scripts/audit-accounting-integrity.mjs",
    "db:snapshot": "node scripts/backup-database-snapshot.mjs",
    "db:apply-proposed": "node scripts/apply-proposed-migrations.mjs --confirm",
    "db:backfill-accruals": "node scripts/backfill-rent-accruals.mjs",
    "test:payroll": "node scripts/test-payroll-scenarios.mjs --prod-functions",
    "test:payroll:local": "node scripts/test-payroll-scenarios.mjs",
    "test:rollback": "node scripts/test-migration-rollback.mjs",
    "test:scenarios": "node scripts/test-accounting-scenarios.mjs",
    "test:scenarios:prod": "node scripts/test-accounting-scenarios.mjs --prod-functions",
    "test:scenarios:proposed": "node scripts/test-accounting-scenarios.mjs --prod-functions --apply docs/proposed-migrations/078_security_and_ledger_fixes.sql --apply docs/proposed-migrations/080_payroll.sql --apply docs/proposed-migrations/081_rent_safety.sql",
    "verify:tenant-period": "npx tsx scripts/verify-tenant-rent-period.mjs",
    "verify:tenant-pdf": "npx tsx scripts/verify-tenant-rent-pdf.mjs",
    "verify:pdf-adaptive": "npx tsx scripts/verify-pdf-adaptive-money.mjs",
    "verify:contacts": "npx tsx scripts/verify-contact-form-preserves-profile-data.mjs",
    "verify:audit-safe": "node scripts/verify-audit-is-read-only.mjs",
    "verify:lists": "npx tsx scripts/verify-list-utilities.mjs",
    "verify:payroll-pdf": "npx tsx scripts/verify-payroll-pdf.mjs",
    "verify:design": "node scripts/verify-design-tokens.mjs",
    "verify:rent-allocation": "npx tsx scripts/verify-rent-allocation.mjs",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "backup:restore-cold": "node scripts/restore-cold-backup.mjs"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-direction": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@react-pdf/renderer": "^4.0.0",
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.45.4",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-table": "^8.20.5",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.11.1",
    "lucide-react": "^0.577.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "pg": "^8.21.0",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "react-is": "^19.2.9",
    "recharts": "^3.10.1",
    "sonner": "^1.5.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.7.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.4.47",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.2"
  }
}
