{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Production shell: the hosted Fluxen UI on its production origin only, the cold-backup commands, and Tauri's read-only core defaults. No local origin ships in the release.",
  "windows": ["main"],
  "remote": {
    "urls": [
      "https://taj-mall-nu.vercel.app",
      "https://taj-mall-nu.vercel.app/*"
    ]
  },
  "permissions": [
    "core:default",
    "allow-save-cold-backup",
    "allow-list-cold-backups",
    "allow-reveal-backups-folder",
    "allow-export-backup-copy",
    "allow-get-backups-dir",
    "allow-get-shell-info"
  ]
}
