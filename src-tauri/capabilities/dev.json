{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "dev",
  "description": "Local development only: the Next dev server. It is NOT listed in tauri.conf.json, so a release never carries it; `npm run tauri:dev` enables it through tauri.dev.conf.json.",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://localhost:3000",
      "http://localhost:3000/*",
      "http://127.0.0.1:3000",
      "http://127.0.0.1:3000/*"
    ]
  },
  "permissions": [
    "core:default",
    "allow-save-cold-backup",
    "allow-list-cold-backups",
    "allow-reveal-backups-folder",
    "allow-export-backup-copy",
    "allow-get-backups-dir",
    "allow-get-shell-info"
  ]
}
